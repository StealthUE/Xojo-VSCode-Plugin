{
  "name": "vsxojo",
  "publisher": "MassiveDynamicEngineering",
  "displayName": "VSXojo",
  "description": "VSCode extension for reading and editing Xojo XML project files",
  "version": "0.1.8",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/StealthUE/Xojo-VSCode-Plugin"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:vsxojo.projectEditor",
    "onLanguage:xojo",
    "onView:xojoExplorer",
    "onView:xojoSignatureView",
    "workspaceContains:**/*.xojo_xml_project",
    "workspaceContains:**/*.xojo_binary_project"
  ],
  "icon": "resources/xojo-logo.png",
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[xojo]": {
        "editor.autoIndent": "full"
      }
    },
    "configuration": {
      "title": "VSXojo",
      "properties": {
        "vsxojo.maxFileSizeMB": {
          "type": "number",
          "default": 50,
          "description": "Maximum file size in MB for automatic parsing. Larger files will show a warning."
        },
        "vsxojo.aiTool": {
          "type": "string",
          "default": "All",
          "enum": ["All", "Claude Code", "Cline", "Cursor", "GitHub Copilot"],
          "enumDescriptions": [
            "Write context files for all AI tools",
            "Write CLAUDE.md only",
            "Write .clinerules only",
            "Write .cursorrules only",
            "Write .github/copilot-instructions.md only"
          ],
          "description": "Which AI assistant to generate project context files for."
        },
        "vsxojo.backupCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How many rolling backups of each Xojo project file to keep. A backup is taken automatically before every write-back. Backups live in the extension's global storage, never in your working copy — restore one with \"Restore Project Backup\"."
        },
        "vsxojo.backupMaxTotalMB": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "Total size cap across all projects' backups, in MB. Each backup is a full copy of the project file, so backupCount alone is unbounded once several large projects are in play. The oldest snapshots are removed when the total is exceeded; every project always keeps its newest. Set to 0 to disable the cap."
        },
        "vsxojo.pendingEditRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "How long to keep recovery copies in pending-edits/ that no longer belong to a recorded write-back failure. Copies still referenced by _writeback_errors.json are never removed, whatever their age. Set to 0 to keep everything."
        },
        "vsxojo.writeBackDelayMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "How long to wait after a save before writing changes back to the Xojo XML. Saves arriving within this window are batched into a single write, so saving several files at once rebuilds the project file only once."
        },
        "vsxojo.classCatalog.allowNetwork": {
          "type": "boolean",
          "default": true,
          "description": "When no version-pinned Xojo class reference is available, offer to download one from documentation.xojo.com. Turn off to suppress the prompt entirely."
        },
        "vsxojo.classCatalog.enforce": {
          "type": "boolean",
          "default": true,
          "description": "Validate newEvent / newControl names against the Xojo class reference. Turn off to write any identifier, matching older VSXojo behaviour."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "vsxojo.projectEditor",
        "displayName": "Xojo Project",
        "selector": [
          { "filenamePattern": "**/*.xojo_xml_project" },
          { "filenamePattern": "**/*.xojo_xml_code" },
          { "filenamePattern": "**/*.xojo_binary_project" },
          { "filenamePattern": "**/*.xojo_binary_code" }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "xojoxml",
        "aliases": ["Xojo XML", "xojoxml"],
        "extensions": [".xojo_xml_project", ".xojo_xml_code"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xojo",
        "aliases": ["Xojo", "xojo"],
        "extensions": [".xojo"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xojoxml",
        "scopeName": "text.xml.xojoxml",
        "path": "./syntaxes/xojoxml.tmLanguage.json"
      },
      {
        "language": "xojo",
        "scopeName": "source.xojo",
        "path": "./syntaxes/xojo.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "xojoExplorer",
          "name": "Xojo Project",
          "icon": "$(folder)",
          "contextualTitle": "Xojo Project Explorer",
          "when": "xojoExplorer.projectLoaded"
        },
        {
          "id": "xojoSignatureView",
          "name": "Signature",
          "type": "webview",
          "contextualTitle": "Xojo Signature",
          "when": "xojoExplorer.projectLoaded"
        }
      ]
    },
    "commands": [
      {
        "command": "xojo.openProject",
        "title": "Open Xojo Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "xojo.convertToXml",
        "title": "Xojo: Convert Binary Project to XML",
        "icon": "$(file-code)"
      },
      {
        "command": "xojo.refreshExplorer",
        "title": "Refresh from Project (re-export)",
        "icon": "$(refresh)"
      },
      {
        "command": "xojo.openCodeItem",
        "title": "Open in Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "xojo.exportProject",
        "title": "Export Project for AI (CODEBASE.md)",
        "icon": "$(export)"
      },
      {
        "command": "xojo.openExportFolder",
        "title": "Open Export Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "xojo.restoreBackup",
        "title": "Restore Project Backup",
        "icon": "$(history)"
      },
      {
        "command": "xojo.repairUiState",
        "title": "Repair Duplicate IDE Window States",
        "icon": "$(window)"
      },
      {
        "command": "xojo.cleanup",
        "title": "Clean Up Generated Files",
        "icon": "$(trash)"
      },
      {
        "command": "xojo.showLog",
        "title": "Show Activity Log",
        "icon": "$(output)"
      },
      {
        "command": "xojo.selectAI",
        "title": "Select AI Tool",
        "icon": "$(robot)"
      },
      {
        "command": "xojo.newModule",
        "title": "New Module",
        "icon": "$(add)"
      },
      {
        "command": "xojo.newClass",
        "title": "New Class",
        "icon": "$(add)"
      },
      {
        "command": "xojo.newMethod",
        "title": "New Method",
        "icon": "$(add)"
      },
      {
        "command": "xojo.newProperty",
        "title": "New Property",
        "icon": "$(add)"
      },
      {
        "command": "xojo.findCallers",
        "title": "Find Callers",
        "icon": "$(references)"
      },
      {
        "command": "xojo.checkSync",
        "title": "Check Sync Status",
        "icon": "$(sync)"
      },
      {
        "command": "xojo.openPicture",
        "title": "View Image",
        "icon": "$(file-media)"
      },
      {
        "command": "xojo.exportOtherProject",
        "title": "Export Other Project for Comparison",
        "icon": "$(compare-changes)"
      },
      {
        "command": "xojo.linkProject",
        "title": "Link Related Xojo Project",
        "icon": "$(link)"
      },
      {
        "command": "xojo.unlinkProject",
        "title": "Unlink Xojo Project",
        "icon": "$(link-external)"
      },
      {
        "command": "xojo.updateClassReference",
        "title": "Update Xojo Class Reference",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "xojo.selectAI",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.refreshExplorer",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.exportProject",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.openExportFolder",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.newModule",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.newClass",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.checkSync",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.showLog",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.exportOtherProject",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.linkProject",
          "when": "view == xojoExplorer",
          "group": "navigation"
        },
        {
          "command": "xojo.updateClassReference",
          "when": "view == xojoExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "xojo.openCodeItem",
          "when": "view == xojoExplorer && viewItem =~ /^method|^event/",
          "group": "inline"
        },
        {
          "command": "xojo.newMethod",
          "when": "view == xojoExplorer && viewItem == block",
          "group": "1_create@1"
        },
        {
          "command": "xojo.newProperty",
          "when": "view == xojoExplorer && viewItem == block",
          "group": "1_create@2"
        },
        {
          "command": "xojo.findCallers",
          "when": "view == xojoExplorer && viewItem =~ /^method|^event/",
          "group": "2_navigate@1"
        },
        {
          "command": "xojo.openPicture",
          "when": "view == xojoExplorer && viewItem == picture",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "xojo.openProject",
          "when": "resourceExtname == .xojo_xml_project",
          "group": "7_modification"
        },
        {
          "command": "xojo.linkProject",
          "when": "resourceExtname == .xojo_xml_project || resourceExtname == .xojo_xml_code",
          "group": "7_modification"
        },
        {
          "command": "xojo.openProject",
          "when": "resourceExtname == .xojo_xml_code",
          "group": "7_modification"
        },
        {
          "command": "xojo.openProject",
          "when": "resourceExtname == .xojo_binary_project",
          "group": "7_modification"
        },
        {
          "command": "xojo.openProject",
          "when": "resourceExtname == .xojo_binary_code",
          "group": "7_modification"
        },
        {
          "command": "xojo.convertToXml",
          "when": "resourceExtname == .xojo_binary_project || resourceExtname == .xojo_binary_code",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node scripts/node-tests.js",
    "build:catalog": "npm run compile && node scripts/build-class-catalog.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "eslint": "^8.34.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5",
    "@vscode/test-electron": "^2.2.3"
  },
  "dependencies": {
    "fast-xml-parser": "^4.2.5"
  }
}
